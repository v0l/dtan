{
  "name": "dtan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && bun run build:client && bun run build:ssr",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build -c vite.ssr.config.ts",
    "check": "tsc --noEmit",
    "deploy": "yarn build && yarn dlx wrangler pages deploy dist"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@snort/shared": "^2.0.1",
    "@snort/system": "^2.1.7",
    "@snort/system-react": "^2.2.0",
    "@snort/system-wasm": "^2.0.0",
    "@snort/worker-relay": "^2.0.1",
    "classnames": "^2.5.1",
    "marked": "^18.0.9",
    "marked-footnote": "^1.4.0",
    "qr-code-styling": "^1.9.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@nsyte/cli": "npm:@jsr/nsyte__cli",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "express": "^5.2.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "prettier": {
    "printWidth": 120
  }
}
